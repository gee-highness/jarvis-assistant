<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jarvis_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jarvis_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/jarvis_widget_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.15"
            android:text="J.A.R.V.I.S."
            android:textColor="#22D3EE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_chat_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="Ready · offline"
            android:textColor="#7F9AA6"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/jarvis_chat_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="You: —"
        android:textColor="#9FB3BD"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/jarvis_chat_answer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="6"
        android:text="At your service, sir. Tap below to ask anything."
        android:textColor="#E6F4F8"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_chat_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/jarvis_widget_pill"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Ask Jarvis…"
            android:textColor="#9FB3BD"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/jarvis_chat_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/jarvis_widget_orb"
            android:contentDescription="Talk to Jarvis"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_mic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_chat_chip1"
            style="@style/JarvisWidgetChip"
            android:text="What's next?" />

        <TextView
            android:id="@+id/jarvis_chat_chip2"
            style="@style/JarvisWidgetChip"
            android:layout_marginStart="6dp"
            android:text="Plan my day" />

        <TextView
            android:id="@+id/jarvis_chat_chip3"
            style="@style/JarvisWidgetChip"
            android:layout_marginStart="6dp"
            android:text="Capture" />
    </LinearLayout>
</LinearLayout>
